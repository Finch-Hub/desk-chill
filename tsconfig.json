{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "pdfjs-dist/build/pdf.mjs": ["node_modules/pdfjs-dist/build/pdf.mjs"],
      "pdfjs-dist/web/pdf_viewer.mjs": ["node_modules/pdfjs-dist/web/pdf_viewer.mjs"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.ts"]
}
